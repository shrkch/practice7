digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.4, dpi=150];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.14,0.08"];
edge [fontname="Times New Roman", fontsize=10, color="#555555"];

start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];

n1 [label="Создать заказ сотрудника через OrderService\nи сохранить его в OrderRepository (вариант 26)"];
n2 [label="Получить товар и количество", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n3 [label="A1 Проверить заказ в статусе DRAFT, товар\n(id, name не пустые, price > 0) и количество в [1, 100]"];
n4 [label="Позиция корректна", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="Товар уже есть в заказе", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Обновить количество (increase)\nили добавить позицию (new OrderItem)"];
n7 [label="Есть ещё позиции", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n8 [label="Рассчитать итог: сумма getLineTotal()\nвсех позиций, без поля total"];
n9 [label="A2 Подтвердить заказ: проверить, что он не пустой\nи в статусе DRAFT; установить CONFIRMED"];

start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> n2 [label="нет: сообщение об ошибке", constraint=false];
n5 -> n6 [label="да: increase / нет: new OrderItem"];
n6 -> n7;
n7 -> n2 [label="да", constraint=false];
n7 -> n8 [label="нет"];
n8 -> n9;
n9 -> end;
}
